# ==========================================
# ROAST MY YOUTUBE - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Cloud OAuth 2.0 Credentials
# Create a Web Client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 2. NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=roast_my_youtube_super_secret_local_dev_key_12345
NEXTAUTH_URL=http://localhost:3000

# 3. Google Gemini AI API Key (For generating hilarious, personalized roasts)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

